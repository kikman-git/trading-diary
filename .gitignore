# ---------------------------------------------------------------------------
# trading-diary .gitignore
# ---------------------------------------------------------------------------

# --- Private trade data: NEVER commit --------------------------------------
# data/ holds journal.db (+ -wal/-shm), screenshots/<tradeId>/, nightly
# backups/ (db snapshots + screenshot tarballs) and backup.log.
# Schema lives in src/db/schema.ts; drizzle/ (migrations) IS committed.
/data/
data/journal.db*
media/uploads/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# --- Secrets & local config -------------------------------------------------
# The app needs no secrets today (DATA_DIR is its only variable); these are
# guards. .env.example is the committed template.
.env
.env.*
!.env.example
secrets/
*.key
*.pem
.vault*

# --- Dependencies & build output (Next.js) ---------------------------------
node_modules/
.next/
/build/
/out/
*.tsbuildinfo
next-env.d.ts

# --- Logs ----------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python tooling (unused here; guard for ad-hoc scripts) ----------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Local tooling, backups & editor ---------------------------------------
# .claude/ only holds settings.local.json (per-machine permission allowlist).
.claude/
*.bak*
.DS_Store
